{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@domain/*": ["./core/domain/*"],
      "@application/*": ["./core/application/*"],
      "@infrastructure/*": ["./core/infrastructure/*"],
      "@schemas/*": ["./core/schemas/*"]
    }
  }
}